{
  "hosting": {
    "site": "scalewithai-vc",
    "public": "frontend/public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "chatbot-api",
          "region": "europe-west1"
        }
      }
    ],
    "headers": [
      {
        "source": "**/*.js",
        "headers": [{"key": "Cache-Control", "value": "public, max-age=3600"}]
      },
      {
        "source": "**/*.css",
        "headers": [{"key": "Cache-Control", "value": "public, max-age=3600"}]
      }
    ]
  }
}
